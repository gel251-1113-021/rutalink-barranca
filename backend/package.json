{
  "name": "rutalink-backend",
  "version": "1.0.0",
  "description": "Backend API REST y WebSockets en tiempo real para RutaLink (UNAB)",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "db:migrate": "ts-node-dev scripts/migrate.ts",
    "db:seed": "ts-node-dev scripts/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.3",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.8",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
