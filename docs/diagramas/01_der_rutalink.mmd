    PROFILES {
        uuid id PK
        string full_name
        string email UK
        string phone
        string active_role
        string account_status
        numeric rating
        int total_trips
        string emergency_contact_name
        string emergency_contact_phone
        timestamptz created_at
    }

    GROUPS {
        uuid id PK
        string name
        string type
        string description
        string base_address
        geometry base_location
        string contact_phone
        string fare_range
        uuid created_by FK
    }

    GROUP_MEMBERS {
        uuid id PK
        uuid group_id FK
        uuid user_id FK
        string role_in_group
        string status
    }

    STOPS {
        uuid id PK
        uuid group_id FK
        string name
        string type
        geometry location
        string address_reference
        boolean is_active
    }

    VEHICLES {
        uuid id PK
        uuid owner_id FK
        uuid group_id FK
        string plate UK
        string brand_model
        string vehicle_type
        jsonb seat_layout
        int capacity
        boolean roof_rack
        int max_cargo_kg
        string status
        geometry current_location
    }

    STOP_LIVE_STATUS {
        uuid id PK
        uuid stop_id FK
        uuid dispatcher_id FK
        int queued_vehicles_count
        string status_note
        string photo_url
        geometry verified_location
        timestamptz updated_at
    }

    DISPATCHER_SHIFTS {
        uuid id PK
        uuid dispatcher_id FK
        uuid stop_id FK
        time start_time
        time end_time
        int_array days_of_week
        boolean is_active
    }

    WAITING_PASSENGERS {
        uuid id PK
        uuid user_id FK
        uuid group_id FK
        geometry location
        string destination_reference
        timestamptz expires_at
    }

    TRIPS_AND_AGREEMENTS {
        uuid id PK
        uuid passenger_id FK
        uuid driver_id FK
        uuid vehicle_id FK
        geometry origin_location
        geometry destination_location
        numeric agreed_price
        string status
        uuid tracking_token
        boolean panic_triggered
    }

    CHAT_MESSAGES {
        uuid id PK
        uuid group_id FK
        uuid trip_id FK
        uuid sender_id FK
        string message
        boolean is_announcement
        timestamptz created_at
    }

    AUDIT_LOGS {
        uuid id PK
        uuid user_id FK
        string action
        jsonb details
        string ip_address
        timestamptz created_at
    }
